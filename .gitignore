# =========================
# Flex it! monorepo
# Next.js frontend + Express/Prisma backend
# =========================

# ----- Dependencies -----
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.npm/
.pnpm-store/

# ----- Environment / secrets (never commit real values) -----
.env
.env.*
!.env.example
!**/.env.example
**/.env
**/.env.local
**/.env.development
**/.env.development.local
**/.env.test
**/.env.test.local
**/.env.production
**/.env.production.local
.dev.vars
*.pem
*.p12
*.key
id_rsa
id_rsa.pub
*.secret

# ----- Next.js (frontend) -----
frontend/.next/
frontend/out/
frontend/build/
.open-next/
.vercel/
next-env.d.ts
frontend/next-env.d.ts

# ----- Backend / Node -----
backend/dist/
backend/build/
backend/generated/
**/dist/
**/build/
*.tsbuildinfo

# ----- Prisma -----
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/dev.db
backend/prisma/dev.db-journal

# ----- Uploads / media (keep folder, ignore files) -----
backend/uploads/*
!backend/uploads/.gitkeep
frontend/public/uploads/*
!frontend/public/uploads/.gitkeep

# ----- Logs & debug -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----- Test / coverage -----
coverage/
**/coverage/
.nyc_output/
*.lcov
playwright-report/
test-results/
.turbo/

# ----- OS junk -----
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ----- Editors / IDE -----
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ----- Cloudflare / Wrangler -----
.wrangler/
.mf/

# ----- Docker / local DB dumps -----
*.sql.gz
*.dump
docker-data/

# ----- Audits / reports -----
lighthouse-report.json
lighthouse.html
.eslintcache
.stylelintcache

# ----- Misc -----
*.local
.cache/
tmp/
temp/
.temp/

# ----- Local / AI / status docs (not needed on GitHub) -----
ADMIN.md
AGENTS.md
CLAUDE.md
PROJECT-STATUS.md
backend/docs/BACKEND-STATUS.md
