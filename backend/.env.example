# Database
DATABASE_URL="postgresql://flexit:flexit@localhost:5432/flexit?schema=public"

# Server (overrides config.json → server.port)
PORT=3001
HOST=0.0.0.0

# Auth (secret — keep out of config.json)
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# CORS (overrides config.json → cors.origin)
CORS_ORIGIN="http://localhost:3000"

# Admin seed password (change before first seed / never use in production)
ADMIN_PASSWORD="change-me-before-first-seed"

# Optional store default (overrides config.json → store.defaultWhatsappNumber)
NEXT_PUBLIC_WHATSAPP_NUMBER="923330215663"
